---
import { Font, getImage } from 'astro:assets';
import { IconArrowLeft } from '@tabler/icons-astro';
import CoverTooltip from '../../components/CoverTooltip.astro';
import FlightItem from '../../components/FlightItem.astro';
import Seo from '../../components/Seo.astro';
import Windsock from '../../components/Windsock.tsx';
import { getFlights } from '../../lib/flying';
import '../../styles/global.css';

const flights = await getFlights();
const title = 'Flying';
const description =
	'Paragliding flights, with the GPS track of each one replayed over the terrain it was flown across.';


import Photos from "../../components/Photos.tsx";
import giumello1 from "../../content/flying/alpe-giumello/1.jpg";
import giumello2 from "../../content/flying/alpe-giumello/2.jpg";
import giumello3 from "../../content/flying/alpe-giumello/3.jpg";
import turesCover from "../../content/flying/campo-tures/cover.jpg";
import castelluccio1 from "../../content/flying/castelluccio-di-norcia/1.jpg";
import castelluccio2 from "../../content/flying/castelluccio-di-norcia/2.jpg";
import castelluccio3 from "../../content/flying/castelluccio-di-norcia/3.jpg";

/* `src` is sized for the enlarged card on a 2x screen (~210 CSS px wide),
   `full` for a pinch at max zoom on a 3x phone (~390 CSS px wide) */
const photos = await Promise.all(
  [
    [giumello1, "Alpe Giumello"],
    [giumello2, "Alpe Giumello"],
    [castelluccio1, "Castelluccio"],
    [turesCover, "Campo Tures"],
    [castelluccio2, "Piani di Castelluccio"],
    [giumello3, "Pizza between flights!"],
    [castelluccio3, "Norcia"],
  ].map(async ([src, caption]) => ({
    src: (await getImage({ src, width: 440, height: 528, fit: "cover", format: "webp", quality: 75 })).src,
    full: (await getImage({ src, width: 1200, height: 1440, fit: "cover", format: "webp", quality: 80 })).src,
    caption,
  })),
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="16x16 32x32" />
		<link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16.png`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Davide Ferrari"
			href={`${import.meta.env.BASE_URL}index.xml`}
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} image={flights[0]?.data.cover} />
		<Font cssVariable="--font-geist" preload />
		<title>{title}</title>
	</head>
	<body>
		<main class="mx-auto flex min-h-screen max-w-xl grow flex-col gap-12 px-4 py-20">
			<div class="flex flex-col gap-4">
				<h1 class="text-foreground">{title}</h1>
				<p class="text-muted-foreground">
					I fly paragliders. Badly, so far, but the view is the same either way. Every flight below
					comes with its GPS track, replayed over the terrain it was actually flown across &mdash;
					press play and follow along.
				</p>
			</div>

			<section class="flex flex-col gap-2" id="flights">
				{flights.map((flight) => <FlightItem flight={flight} />)}
			</section>
			<CoverTooltip scope="#flights" />

			<Photos client:load photos={photos} label="Photos from my flights" />

			<div class="flex items-center justify-between">
				<a
					class="group inline-flex items-center gap-1.5 rounded-full bg-surface px-3 py-1.5 text-sm font-[450] text-gray-1200 transition-colors duration-200 hover:bg-gray-1100/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-1200"
					href={import.meta.env.BASE_URL}
				>
					<IconArrowLeft
						class="motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-out motion-safe:group-hover:-translate-x-0.5 motion-safe:group-focus-visible:-translate-x-0.5"
						size={16}
						stroke={1.75}
						aria-hidden="true"
					/>
					Back
				</a>
				<Windsock client:idle size="2rem" />
			</div>
		</main>
	</body>
</html>

<style>
	body {
		color: var(--color-foreground);
	}
</style>
