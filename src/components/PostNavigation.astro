---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const baseDepth = Math.min(...headings.map((heading) => heading.depth));
---

<aside class="post-navigation">
	<post-navigation>
		<nav aria-label="On this page">
			<p class="index-label">On this page</p>
			<ol>
				{headings.map((heading) => (
					<li>
						<a
							class="link-outline"
							href={`#${heading.slug}`}
							style={`--depth: ${heading.depth - baseDepth}`}
						>
							{heading.text}
						</a>
					</li>
				))}
			</ol>
		</nav>
	</post-navigation>
</aside>

<style>
	.post-navigation {
		display: none;
	}

	@media (min-width: 80rem) {
		.post-navigation {
			display: block;
			position: absolute;
			inset-block: 6rem;
			left: calc(100% + 1.5rem);
			width: 13rem;
		}
	}

	post-navigation {
		display: block;
		position: sticky;
		top: 3rem;
		max-height: calc(100dvh - 6rem);
		overflow-y: auto;
		scrollbar-width: thin;
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.index-label {
		margin-bottom: 0.875rem;
		color: var(--color-foreground);
		font-weight: 500;
	}

	ol {
		border-left: 1px solid var(--color-code-border);
	}

	a {
		display: block;
		margin-left: -1px;
		padding: 0.375rem 0.25rem 0.375rem calc(0.875rem + var(--depth) * 0.625rem);
		border-left: 1px solid transparent;
		color: var(--color-muted-foreground);
		overflow-wrap: anywhere;
		transition: color 150ms ease, border-color 150ms ease;
	}

	a:hover,
	a[aria-current="location"] {
		color: var(--color-foreground);
	}

	a[aria-current="location"] {
		border-left-color: var(--color-foreground);
	}
</style>

<script>
	class PostNavigation extends HTMLElement {
		connectedCallback() {
			const links = [...this.querySelectorAll<HTMLAnchorElement>('a')];
			const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
			const desktop = window.matchMedia('(min-width: 80rem)');
			let frame = 0;

			const update = () => {
				frame = 0;
				if (!desktop.matches) return;
				let current = -1;
				sections.forEach((section, index) => {
					if (section && section.getBoundingClientRect().top <= 100) current = index;
				});
				links.forEach((link, index) => {
					if (index === current) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
			};

			const schedule = () => {
				if (!frame) frame = requestAnimationFrame(update);
			};
			window.addEventListener('scroll', schedule, { passive: true });
			window.addEventListener('resize', schedule);
			update();
			this.cleanup = () => {
				cancelAnimationFrame(frame);
				window.removeEventListener('scroll', schedule);
				window.removeEventListener('resize', schedule);
			};
		}

		cleanup = () => {};

		disconnectedCallback() {
			this.cleanup();
		}
	}

	customElements.define('post-navigation', PostNavigation);
</script>
